    {
     "who": "kai",
     "mood": "happy",
     "text": "Oye, Ren. Hana es muy linda, ¿no crees?",
     "start": 6.907,
     "dur": 3.256,
     "audio": "drama/cap3/l1.wav"
    },
    {
     "who": "ren",
     "mood": "blush",
     "thought": true,
     "fx": "hearts",
     "text": "Sí lo es... me encanta su sonrisa. ¿Pero qué estoy pensando? Nunca me había sentido así por una chica.",
     "start": 10.513,
     "dur": 8.11,
     "audio": "drama/cap3/l2.wav"
    },
    {
     "who": "kai",
     "mood": "talk",
     "text": "¡Oye, Ren!",
     "start": 18.974,
     "dur": 0.966,
     "audio": "drama/cap3/l3.wav"
    },
    {
     "who": "ren",
     "mood": "cold",
     "text": "¿Qué quieres, Kai?",
     "start": 20.29,
     "dur": 1.336,
     "audio": "drama/cap3/l4.wav"
    },
    {
     "who": "kai",
     "mood": "talk",
     "text": "Te pregunté si te parece linda Hana.",
     "start": 21.976,
     "dur": 2.06,
     "audio": "drama/cap3/l5.wav"
    },
    {
     "who": "ren",
     "mood": "cold",
     "text": "Ella es solo una molestia.",
     "start": 24.386,
     "dur": 1.743,
     "audio": "drama/cap3/l6.wav"
    },
    {
     "who": "kai",
     "mood": "happy",
     "text": "Bueno, dejemos de hablar de chicas. ¿Cuándo empiezan las clases?",
     "start": 26.48,
     "dur": 4.069,
     "audio": "drama/cap3/l7.wav"
    },
    {
     "who": "ren",
     "mood": "cold",
     "text": "En dos días. Y todos vamos a estar en la misma clase.",
     "start": 30.898,
     "dur": 3.816,
     "audio": "drama/cap3/l8.wav"
    },
    {
     "who": "kai",
     "mood": "happy",
     "text": "¡Qué bien! Así podré ver a Yui.",
     "start": 35.064,
     "dur": 2.026,
     "audio": "drama/cap3/l9.wav"
    },
    {
     "who": "ren",
     "mood": "happy",
     "text": "¿Te gusta Yui?",
     "start": 37.44,
     "dur": 0.893,
     "audio": "drama/cap3/l10.wav"
    },
    {
     "who": "kai",
     "mood": "blush",
     "fx": "hearts",
     "text": "T-t-tal v-vez...",
     "start": 38.683,
     "dur": 1.211,
     "audio": "drama/cap3/l11.wav"
    },
    {
     "who": "ren",
     "mood": "cold",
     "text": "Mejor vámonos. Está oscureciendo y nos esperan para cenar.",
     "start": 40.244,
     "dur": 4.42,
     "audio": "drama/cap3/l12.wav"
    },
    {
     "who": "kai",
     "mood": "happy",
     "text": "¡Sí, vamos!",
     "start": 45.015,
     "dur": 1.065,
     "audio": "drama/cap3/l13.wav"
    }
   ]
  },
  {
