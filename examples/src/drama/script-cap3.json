 "scenes": [
  {"id":"title","pad":3.0,"lines":[
   {"who":"narr","text":"Mientras tanto, afuera en la terraza..."}]},
  {"id":"terrace","pad":0.6,"lines":[
   {"who":"kai","mood":"happy","text":"Oye, Ren. Hana es muy linda, ¿no crees?"},
   {"who":"ren","mood":"blush","thought":true,"fx":"hearts","text":"Sí lo es... me encanta su sonrisa. ¿Pero qué estoy pensando? Nunca me había sentido así por una chica."},
   {"who":"kai","mood":"talk","text":"¡Oye, Ren!"},
   {"who":"ren","mood":"cold","text":"¿Qué quieres, Kai?"},
   {"who":"kai","mood":"talk","text":"Te pregunté si te parece linda Hana."},
   {"who":"ren","mood":"cold","text":"Ella es solo una molestia."},
   {"who":"kai","mood":"happy","text":"Bueno, dejemos de hablar de chicas. ¿Cuándo empiezan las clases?"},
   {"who":"ren","mood":"cold","text":"En dos días. Y todos vamos a estar en la misma clase."},
   {"who":"kai","mood":"happy","text":"¡Qué bien! Así podré ver a Yui."},
   {"who":"ren","mood":"happy","text":"¿Te gusta Yui?"},
   {"who":"kai","mood":"blush","fx":"hearts","text":"T-t-tal v-vez..."},
   {"who":"ren","mood":"cold","text":"Mejor vámonos. Está oscureciendo y nos esperan para cenar."},
   {"who":"kai","mood":"happy","text":"¡Sí, vamos!"}]},
  {"id":"cafe","pad":0.6,"lines":[
   {"who":"kai","mood":"happy","enter":["kai","ren"],"text":"¡Hola, Miki! ¡Hola, Hana!"},
   {"who":"hana","mood":"happy","text":"Hola, Kai. Hola, Ren."},
   {"who":"ren","mood":"cold","text":"Veo que ya te calmaste."},
   {"who":"lia","mood":"talk","text":"Oye, Hana... ¿quiénes son los chicos que se sentaron a tu lado?"},
   {"who":"hana","mood":"talk","text":"El pelirrojo es Kai, y el de pelo negro es Ren."},
   {"who":"bruno","mood":"happy","enter":["bruno"],"text":"Oigan, ¿qué tanto se secretean?"},
   {"who":"hana","mood":"happy","text":"¡Nada! Les presento: él es Kai, y él es Ren."},
   {"who":"lia","mood":"happy","text":"Mucho gusto, yo soy Lía."},
   {"who":"bruno","mood":"happy","text":"Yo soy Bruno."},
   {"who":"shin","mood":"cold","text":"Yo soy Shin."},
   {"who":"mei","mood":"happy","text":"¡Yo soy Mei!"},
   {"who":"yui","mood":"blush","text":"Y-yo soy Yui."},
   {"who":"sora","mood":"angry","text":"Y yo soy Sora. El primo de Yui."},
   {"who":"hana","mood":"happy","text":"Bueno, basta de presentaciones. ¿Qué tal si pedimos una pizza?"},
   {"who":"kai","mood":"happy","with":"lia","text":"¡Sí, pizza!"},
   {"who":"kai","mood":"laugh","fx":"pizza","text":"¡Mmm, qué deliciosa!"},
   {"who":"hana","mood":"happy","text":"Sí, está deliciosa."},
   {"who":"lia","mood":"laugh","text":"¡Nunca había probado una pizza tan rica en mi vida!"},
   {"who":"hana","mood":"talk","with":"miki","text":"Lía, no exageres."},
   {"who":"lia","mood":"happy","text":"Ya sé, ¡pero está deliciosa!"},
   {"who":"hana","mood":"angry","with":"mei","text":"¡Lía!"},
   {"who":"lia","mood":"nervous","text":"¿Qué?"},
   {"who":"tess","mood":"cold","text":"No hables con la boca llena."},
   {"who":"lia","mood":"happy","text":"¡Ah, okay!"},
   {"who":"ren","mood":"cold","with":"hana","text":"Bueno, nosotros ya nos vamos."},
   {"who":"mei","mood":"happy","with":"yui","text":"¡Nos vemos en clases!"},
   {"who":"hana","mood":"happy","text":"¡Sí, hasta luego!"}]},
  {"id":"end","pad":0.4,"tail":3.2,"lines":[]}
 ]
