   "lines": [
    {
     "who": "narr",
     "text": "Ren y Kai se fueron. Hana y Miki se quedan solas en la habitación.",
     "start": 3.0,
     "dur": 4.918,
     "audio": "drama/cap2/l0.wav"
    }
   ]
  },
  {
   "id": "talk",
   "start": 8.768,
   "end": 46.188,
   "lines": [
    {
     "who": "hana",
     "mood": "nervous",
     "text": "Se enojó...",
     "start": 9.368,
     "dur": 0.691,
     "audio": "drama/cap2/l1.wav"
    },
    {
     "who": "miki",
     "mood": "sad",
     "text": "Sí. Así es desde la muerte de nuestros padres... y de nuestro hermano mayor.",
     "start": 10.409,
     "dur": 4.54,
     "audio": "drama/cap2/l2.wav"
    },
    {
     "who": "hana",
     "mood": "nervous",
     "text": "¿Qué les pasó?",
     "start": 15.299,
     "dur": 0.761,
     "audio": "drama/cap2/l3.wav"
    },
    {
     "who": "miki",
     "mood": "sad",
     "text": "A mis padres los asesinaron. Y nuestro hermano murió en un accidente de auto hace tres años.",
     "start": 16.41,
     "dur": 6.006,
     "audio": "drama/cap2/l4.wav"
    },
    {
     "who": "hana",
     "mood": "sad",
     "text": "Lo siento mucho. No puedo imaginar ese dolor.",
     "start": 22.765,
     "dur": 3.078,
     "audio": "drama/cap2/l5.wav"
    },
    {
     "who": "miki",
     "mood": "sad",
     "text": "Al principio dolió mucho. Desde entonces Ren se volvió frío y serio. Antes sonreía todo el tiempo.",
     "start": 26.194,
     "dur": 6.772,
     "audio": "drama/cap2/l6.wav"
    },
    {
     "who": "miki",
     "mood": "sad",
     "text": "Yo creo que su alegría se fue con ellos.",
     "start": 33.315,
     "dur": 2.376,
     "audio": "drama/cap2/l7.wav"
    },
    {
     "who": "hana",
     "mood": "talk",
     "text": "Entonces él era alegre como tú... Pero el pasado se queda en el pasado.",
     "start": 36.041,
     "dur": 4.633,
     "audio": "drama/cap2/l8.wav"
    },
    {
     "who": "miki",
     "mood": "happy",
     "text": "Tienes razón. Mejor vivo el presente y espero lo que traiga el futuro.",
     "start": 41.025,
     "dur": 4.314,
     "audio": "drama/cap2/l9.wav"
    }
   ]
  },
